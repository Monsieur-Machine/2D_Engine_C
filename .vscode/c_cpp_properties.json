{
    "configurations": [
        {
            "name": "Linux",
            "intelliSenseMode": "linux-gcc-arm",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/components",
                "${workspaceFolder}/core",
                "${workspaceFolder}/core/host/linux",
                "/usr/include/lua5.4",
                "/usr/include/pipewire-0.3",
                "/usr/include/spa-0.2",
                "/usr/include/libdrm",
                "/usr/include/libdecor-0",
                "/usr/include/x86_64-linux-gnu"//,
//                "${env:HOME}/.local/share/fxsdk/sysroot/sh3eb-elf/include"
            ],
            "compilerPath": "/usr/bin/gcc",
            "defines": [
                "_REENTRANT",
                "FXCG50",
                "TARGET_FXCG50",
                "ASSET_FILE_NAME=\"game.data\""
            ],
            "cStandard": "c17",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ],
    "version": 4
}